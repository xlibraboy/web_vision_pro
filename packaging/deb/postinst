#!/bin/sh
# Debian postinst maintainer script.
#
# Never fails: a missing pylon runtime only means the application cannot start
# yet, and a failing postinst would leave dpkg half-configured.
set -e

if [ ! -d /opt/pylon ]; then
    cat >&2 <<'EOF'
web-vision-pro: Basler pylon was not found in /opt/pylon.
web-vision-pro: The application needs the Basler pylon 6.2 runtime; install it
web-vision-pro: before launching 'web-vision-pro' (see /usr/share/doc/web-vision-pro/INSTALL.md).
EOF
fi

if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database -q /usr/share/applications || true
fi
if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -q -t /usr/share/icons/hicolor || true
fi

exit 0
