{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "skill": {
      "industrial-vision-networking": "allow",
      "paper-machine-event-logic": "allow",
      "pylon-scA780-config": "allow",
      "vision-docker-builder": "allow",
      "vision-pipeline-opencv": "allow",
      "template": "allow"
    }
  },
  "mcp": {
    "obsidian": {
      "type": "local",
      "command": ["npx", "-y", "obsidian-mcp"],
      "enabled": true,
      "env": {
        "OBSIDIAN_API_KEY": "${OBSIDIAN_REST_API_KEY}"
      }
    }
  }
}
